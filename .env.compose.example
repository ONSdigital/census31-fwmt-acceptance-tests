# Copy to .env or export in your shell before docker compose up.

FWMT_PUBSUB_PROJECT=fwmt-local
FWMT_POSTGRES_DB=postgres
FWMT_POSTGRES_USER=postgres
FWMT_POSTGRES_PASSWORD=postgres
FWMT_RESET_DB_SCHEMA=false

# Service host ports
FWMT_TM_MOCK_PORT=8000
FWMT_JOB_SERVICE_PORT=8025
FWMT_OUTCOME_SERVICE_PORT=8030
FWMT_CSV_SERVICE_PORT=8060
FWMT_PUBSUB_EMULATOR_PORT=8085
FWMT_REDIS_PORT=6379
FWMT_POSTGRES_PORT=5432

# Optional image overrides (GAR defaults are already in docker-compose.yaml)
# FWMT_TM_MOCK_IMAGE=europe-west2-docker.pkg.dev/c31-fwmtg-ci-prod/fwmtg-docker-release/census31-fwmt-tm-mock:27.0.3-RC
# FWMT_JOB_SERVICE_IMAGE=europe-west2-docker.pkg.dev/c31-fwmtg-ci-prod/fwmtg-docker-release/census31-fwmt-job-service:27.0.3-RC
# FWMT_OUTCOME_SERVICE_IMAGE=europe-west2-docker.pkg.dev/c31-fwmtg-ci-prod/fwmtg-docker-release/census31-fwmt-outcome-service:27.0.3-RC
# FWMT_CSV_SERVICE_IMAGE=europe-west2-docker.pkg.dev/c31-fwmtg-ci-prod/fwmtg-docker-release/census31-fwmt-csv-service:27.0.3-RC

# Test-only decryption password used by job-service
DECRYPTION_PASSWORD=testJobService
